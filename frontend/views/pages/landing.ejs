<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- SEO -->
  <title><%= title %></title>
  <meta name="description" content="<%= description %>" />
  <meta name="keywords" content="Kishor Mobiles, Kishor Enterprises, mobiles, TVs, ACs, refrigerators, home appliances, Pathapatnam electronics" />
  <meta name="author" content="Kishor Mobiles" />
  <meta name="robots" content="index, follow" />

  <!-- Canonical URL -->
  <link rel="canonical" href="<%= locals.canonicalUrl || 'https://kishormobiles.in/' %>" />

  <!-- Google Search & Browser Favicons (Derived from official Kishor Mobiles logo) -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/images/favicon-48x48.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/android-chrome-192x192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />

  <!-- Open Graph / Social Media Preview -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kishor Mobiles" />
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="<%= description %>" />
  <meta property="og:url" content="<%= locals.canonicalUrl || 'https://kishormobiles.in/' %>" />
  <meta property="og:image" content="https://kishormobiles.in/assets/images/kishor-mobiles-logo.png" />
  <meta property="og:image:width" content="512" />
  <meta property="og:image:height" content="512" />
  <meta property="og:image:alt" content="Kishor Mobiles Official Logo" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= title %>" />
  <meta name="twitter:description" content="<%= description %>" />
  <meta name="twitter:image" content="https://kishormobiles.in/assets/images/kishor-mobiles-logo.png" />

  <!-- Schema.org JSON-LD Structured Data (WebSite + ElectronicsStore) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://kishormobiles.in/#website",
        "url": "https://kishormobiles.in/",
        "name": "Kishor Mobiles",
        "alternateName": "Kishor Enterprises",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://kishormobiles.in/products?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "ElectronicsStore",
        "@id": "https://kishormobiles.in/#store",
        "name": "Kishor Mobiles",
        "alternateName": "Kishor Enterprises",
        "url": "https://kishormobiles.in/",
        "logo": "https://kishormobiles.in/assets/images/kishor-mobiles-logo.png",
        "image": "https://kishormobiles.in/assets/images/kishor-mobiles-logo.png",
        "telephone": "+91-9963657799",
        "priceRange": "₹₹",
        "hasMap": "https://maps.app.goo.gl/MkDAzWNQdQArud8HA?g_st=ac",
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 18.747141,
          "longitude": 84.086327
        },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "All Andhra Road",
          "addressLocality": "Pathapatnam",
          "addressRegion": "Andhra Pradesh",
          "postalCode": "532213",
          "addressCountry": "IN"
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
            "opens": "09:00",
            "closes": "21:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Sunday"],
            "opens": "09:00",
            "closes": "19:00"
          }
        ]
      }
    ]
  }
  </script>

  <!-- Google Fonts — Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <!-- =============================================
       CSS — Load order matters:
       1. Design tokens (variables)
       2. Reset + base
       3. Utilities
       4. Components (one file per section)
       5. Responsive overrides (last)
  ============================================= -->

  <!-- Foundation -->
  <link rel="stylesheet" href="/assets/css/variables.css" />
  <link rel="stylesheet" href="/assets/css/base.css" />
  <link rel="stylesheet" href="/assets/css/utilities.css" />

  <!-- Components -->
  <link rel="stylesheet" href="/assets/css/navbar.css" />
  <link rel="stylesheet" href="/assets/css/hero.css" />
  <link rel="stylesheet" href="/assets/css/trust.css" />
  <link rel="stylesheet" href="/assets/css/categories.css" />
  <link rel="stylesheet" href="/assets/css/featured-products.css" />
  <link rel="stylesheet" href="/assets/css/emi.css" />
  <link rel="stylesheet" href="/assets/css/achievements.css" />
  <link rel="stylesheet" href="/assets/css/location.css" />
  <link rel="stylesheet" href="/assets/css/whatsapp.css" />
  <link rel="stylesheet" href="/assets/css/footer.css" />

  <!-- Auth modal -->
  <link rel="stylesheet" href="/assets/css/login-required-modal.css" />

  <!-- Responsive (must be last) -->
  <link rel="stylesheet" href="/assets/css/responsive.css" />

</head>

<body class="page-loading <%= locals.isAuthenticated ? 'is-authenticated has-mobile-bottom-bar ' + (locals.isAdmin ? 'is-admin' : 'is-user') : '' %>">

  <%# ============================================================
      PARTIALS — Each maps to one future React component.
      Order matches the landing page specification.
  ============================================================ %>

  <%- include('../partials/navbar') %>

  <main id="main-content">

    <%- include('../partials/hero') %>

    <%- include('../partials/trust') %>

    <%- include('../partials/categories') %>

    <%- include('../partials/featured-products') %>

    <%- include('../partials/emi') %>

    <%- include('../partials/achievements') %>

    <%- include('../partials/location') %>

    <%- include('../partials/whatsapp') %>

  </main>

  <%- include('../partials/footer') %>

  <%# Auth guard modal — included once, triggered globally via showLoginRequiredModal() %>
  <%- include('../partials/login-required-modal') %>

  <!-- =============================================
       DATA FILES — Load before JS that depends on them
  ============================================= -->
  <script src="/assets/data/banners.js"></script>
  <script src="/assets/data/categories.js"></script>

  <!-- =============================================
       JAVASCRIPT — Deferred, non-blocking
       Load order: data → sliders → UI components → page-level
  ============================================= -->
  <script src="/assets/js/hero-slider.js"           defer></script>
  <script src="/assets/js/categories.js"             defer></script>
  <script src="/assets/js/featured-slider.js"        defer></script>
  <script src="/assets/js/navbar.js"                 defer></script>
  <script src="/assets/js/whatsapp.js"               defer></script>
  <script src="/assets/js/auth-guard.js"             defer></script>

</body>
</html>

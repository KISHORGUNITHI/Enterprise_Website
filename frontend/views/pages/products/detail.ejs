<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <link rel="icon" type="image/svg+xml" href="/public/icons/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet" />

  <!-- Foundation -->
  <link rel="stylesheet" href="/assets/css/variables.css" />
  <link rel="stylesheet" href="/assets/css/base.css" />
  <link rel="stylesheet" href="/assets/css/utilities.css" />

  <!-- Header (reused exactly — no category strip) -->
  <link rel="stylesheet" href="/assets/css/home-header.css" />
  <link rel="stylesheet" href="/assets/css/category-header.css" />

  <!-- PLP card styles (for related products) -->
  <link rel="stylesheet" href="/assets/css/category-page.css" />

  <!-- PDP styles -->
  <link rel="stylesheet" href="/assets/css/pdp.css" />

  <!-- Footer -->
  <link rel="stylesheet" href="/assets/css/footer.css" />
  <link rel="stylesheet" href="/assets/css/home-footer.css" />

  <!-- Responsive last -->
  <link rel="stylesheet" href="/assets/css/responsive.css" />
</head>

<body>

  <!-- ── Existing category header — reused exactly, NO strip ── -->
  <%- include('../../partials/category-header') %>

    <main id="main-content" class="pdp pdp-below">
      <div class="pdp__container">

        <!-- ══════════════════════════════════════════════════════
           MAIN: Two-column — Gallery (left) | Info (right)
      ══════════════════════════════════════════════════════ -->
        <div class="pdp__main">

          <!-- ─── LEFT: Image Gallery ─── -->
          <div class="pdp-gallery">

            <div class="pdp-gallery__main-wrap" id="pdpMainWrap">
              <span class="pdp-gallery__badge pdp-skeleton" id="pdpBadge"></span>
              <!-- JS injects SVG placeholder or actual image here -->
              <div class="pdp-gallery__main-img" id="pdpMainImg">
                <div class="pdp-skeleton pdp-skeleton--gallery-main">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(148, 163, 184, 0.45)"
                    stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <polyline points="21 15 16 10 5 21" />
                  </svg>
                </div>
              </div>
            </div>

            <div class="pdp-gallery__thumbs" id="pdpThumbs">
              <div class="pdp-skeleton pdp-skeleton--thumb"></div>
              <div class="pdp-skeleton pdp-skeleton--thumb"></div>
              <div class="pdp-skeleton pdp-skeleton--thumb"></div>
              <div class="pdp-skeleton pdp-skeleton--thumb"></div>
            </div>

          </div>

          <!-- ─── RIGHT: Product Info ─── -->
          <div class="pdp-info">

            <!-- Brand -->
            <span class="pdp-info__brand" id="pdpBrand"><span class="pdp-skeleton pdp-skeleton--brand"></span></span>

            <!-- Title + tagline -->
            <div>
              <h1 class="pdp-info__title" id="pdpTitle"><span class="pdp-skeleton--title-wrap"><span
                    class="pdp-skeleton pdp-skeleton--title-1"></span><span
                    class="pdp-skeleton pdp-skeleton--title-2"></span></span></h1>
              <p class="pdp-info__tagline" id="pdpTagline"><span class="pdp-skeleton pdp-skeleton--tagline"></span></p>
            </div>

            <!-- Rating -->
            <div class="pdp-info__rating" id="pdpRating">
              <div class="pdp-skeleton pdp-skeleton--rating"></div>
            </div>

            <!-- Price -->
            <div class="pdp-info__price-block">
              <div class="pdp-info__price-row">
                <span class="pdp-info__price-sale" id="pdpPriceSale"><span
                    class="pdp-skeleton pdp-skeleton--price"></span></span>
                <span class="pdp-info__price-original" id="pdpPriceOrig"></span>
                <span class="pdp-info__price-discount" id="pdpPriceDiscount"></span>
              </div>
              <span class="pdp-info__price-save" id="pdpPriceSave"></span>
            </div>

            <!-- Free Gifts Included Banner -->
            <div class="pdp-free-gift-card reveal" id="pdpFreeGiftsBanner"
              style="display: none; background: linear-gradient(135deg, #fdf4ff 0%, #fbcfe8 100%); border: 1.5px solid #f472b6; border-radius: var(--radius-lg, 12px); padding: 14px 16px; margin-bottom: var(--space-4); box-shadow: 0 4px 12px rgba(219, 39, 119, 0.08);">
              <!-- Populated dynamically by pdp.js -->
            </div>

            <!-- Color Selector -->
            <div class="pdp-colors reveal">
              <p class="pdp-colors__label">
                Color: <span id="pdpColorLabel"><span class="pdp-skeleton pdp-skeleton--color-name"></span></span>
              </p>
              <div class="pdp-colors__options" id="pdpColors">
                <div class="pdp-skeleton pdp-skeleton--color-circle"></div>
                <div class="pdp-skeleton pdp-skeleton--color-circle"></div>
                <div class="pdp-skeleton pdp-skeleton--color-circle"></div>
              </div>
            </div>

            <!-- Variant Selectors -->
            <div class="pdp-variants reveal" id="pdpVariants">
              <div class="pdp-variant-group">
                <div class="pdp-skeleton pdp-skeleton--label" style="margin-bottom: 8px;"></div>
                <div class="pdp-variant-group__options">
                  <div class="pdp-skeleton pdp-skeleton--var-pill"></div>
                  <div class="pdp-skeleton pdp-skeleton--var-pill"></div>
                  <div class="pdp-skeleton pdp-skeleton--var-pill"></div>
                </div>
              </div>
            </div>

            <!-- Delivery Info -->
            <div class="pdp-delivery reveal" id="pdpDelivery">
              <div class="pdp-delivery__row">
                <div class="pdp-skeleton pdp-skeleton--delivery-icon"></div>
                <div style="flex: 1; display: flex; flex-direction: column; gap: 6px;">
                  <div class="pdp-skeleton pdp-skeleton--line" style="width: 38%; height: 16px;"></div>
                  <div class="pdp-skeleton pdp-skeleton--line" style="width: 62%; height: 13px;"></div>
                  <div class="pdp-skeleton pdp-skeleton--line" style="width: 48%; height: 12px;"></div>
                </div>
              </div>
            </div>
            <!-- ── Purchase Action Controls (In-line on mobile between Specs & Reviews; Fixed bottom bar on desktop) ── -->
            <div class="pdp-buy-bar" id="pdpBuyBar" role="region" aria-label="Purchase actions">
              <div class="pdp-buy-bar__inner">

                <button class="pdp-buy-bar__cart" data-action="add-cart" aria-label="Add to cart">
                  <svg class="pdp-buy-bar__cart-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                    stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 2h2l2.5 10M8 15h10l3-8H6.5" />
                    <circle cx="10" cy="19" r="1.5" fill="currentColor" stroke="none" />
                    <circle cx="18" cy="19" r="1.5" fill="currentColor" stroke="none" />
                  </svg>
                  <span class="pdp-buy-bar__cart-label">Add to Cart</span>
                </button>

                <div class="pdp-buy-bar__buy-row">
                  <button class="pdp-buy-bar__buy" data-action="buy-now" aria-label="Buy Now">
                    <span class="pdp-buy-bar__buy-label">Buy Now</span>
                    <span class="pdp-buy-bar__buy-price" id="pdpBarPrice"><span
                        class="pdp-skeleton pdp-skeleton--price-xs"></span></span>
                  </button>
                </div>

              </div>
            </div>

            <!-- Highlights -->
            <div class="pdp-highlights reveal">
              <p class="pdp-section__title">Highlights</p>
              <ul class="pdp-highlights__list" id="pdpHighlights">
                <li class="pdp-highlights__item">
                  <span class="pdp-skeleton pdp-skeleton--hl-bullet"></span>
                  <span class="pdp-skeleton pdp-skeleton--line" style="width: 82%; height: 14px;"></span>
                </li>
                <li class="pdp-highlights__item">
                  <span class="pdp-skeleton pdp-skeleton--hl-bullet"></span>
                  <span class="pdp-skeleton pdp-skeleton--line" style="width: 68%; height: 14px;"></span>
                </li>
                <li class="pdp-highlights__item">
                  <span class="pdp-skeleton pdp-skeleton--hl-bullet"></span>
                  <span class="pdp-skeleton pdp-skeleton--line" style="width: 76%; height: 14px;"></span>
                </li>
                <li class="pdp-highlights__item">
                  <span class="pdp-skeleton pdp-skeleton--hl-bullet"></span>
                  <span class="pdp-skeleton pdp-skeleton--line" style="width: 62%; height: 14px;"></span>
                </li>
              </ul>
            </div>

          </div>
          <!-- end pdp-info -->

        </div>
        <!-- end pdp__main -->


        <!-- ══════════════════════════════════════════════════════
           BELOW FOLD: Description, Specs, Related + Sticky Bar
           The bar is position:sticky inside this wrapper.
           It sticks to the bottom while scrolling through this
           section and naturally stops at the end — zero JS needed.
      ══════════════════════════════════════════════════════ -->
        <div class="pdp-below-wrap">

          <!-- Description -->
          <div class="pdp-description reveal" style="margin-top:var(--space-6);">
            <p class="pdp-section__title">Description</p>
            <div class="pdp-description__body pdp-description__body--collapsed" id="pdpDescBody">
              <div class="pdp-skeleton pdp-skeleton--line" style="width: 100%; height: 14px; margin-bottom: 8px;"></div>
              <div class="pdp-skeleton pdp-skeleton--line" style="width: 94%; height: 14px; margin-bottom: 8px;"></div>
              <div class="pdp-skeleton pdp-skeleton--line" style="width: 88%; height: 14px; margin-bottom: 8px;"></div>
              <div class="pdp-skeleton pdp-skeleton--line" style="width: 58%; height: 14px;"></div>
            </div>
            <button class="pdp-description__toggle" id="pdpDescToggle" type="button" aria-expanded="false"
              style="display:none;">
              Read More
              <svg class="pdp-desc-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="19 12 12 19 5 12"></polyline>
              </svg>
            </button>
          </div>

          <!-- Specifications -->
          <div class="pdp-specs reveal" id="pdpSpecsSection" style="margin-top:var(--space-6);">
            <p class="pdp-section__title">Specifications</p>
            <div id="pdpSpecs">
              <div class="pdp-specs__group">
                <div class="pdp-skeleton pdp-skeleton--line" style="width: 110px; height: 16px; margin-bottom: 12px;">
                </div>
                <table class="pdp-specs__table">
                  <tr class="pdp-specs__row">
                    <td class="pdp-specs__key">
                      <div class="pdp-skeleton pdp-skeleton--line" style="width: 80px; height: 14px;"></div>
                    </td>
                    <td class="pdp-specs__val">
                      <div class="pdp-skeleton pdp-skeleton--line" style="width: 140px; height: 14px;"></div>
                    </td>
                  </tr>
                  <tr class="pdp-specs__row">
                    <td class="pdp-specs__key">
                      <div class="pdp-skeleton pdp-skeleton--line" style="width: 90px; height: 14px;"></div>
                    </td>
                    <td class="pdp-specs__val">
                      <div class="pdp-skeleton pdp-skeleton--line" style="width: 160px; height: 14px;"></div>
                    </td>
                  </tr>
                  <tr class="pdp-specs__row">
                    <td class="pdp-specs__key">
                      <div class="pdp-skeleton pdp-skeleton--line" style="width: 70px; height: 14px;"></div>
                    </td>
                    <td class="pdp-specs__val">
                      <div class="pdp-skeleton pdp-skeleton--line" style="width: 120px; height: 14px;"></div>
                    </td>
                  </tr>
                  <tr class="pdp-specs__row">
                    <td class="pdp-specs__key">
                      <div class="pdp-skeleton pdp-skeleton--line" style="width: 85px; height: 14px;"></div>
                    </td>
                    <td class="pdp-specs__val">
                      <div class="pdp-skeleton pdp-skeleton--line" style="width: 130px; height: 14px;"></div>
                    </td>
                  </tr>
                </table>
              </div>
            </div>
          </div>

          <!-- Rate & Review Section -->
          <div class="pdp-reviews reveal" id="pdpReviewsSection" style="margin-top:var(--space-6);">
            <p class="pdp-section__title">Customer Reviews</p>

            <div class="pdp-reviews__submit-box">
              <h3 class="pdp-reviews__submit-title">Rate and Review the Product</h3>
              <div class="pdp-reviews__star-rating" id="pdpSubmitRating">
                <svg data-star="1" class="pdp-star-icon-interactive" width="24" height="24" viewBox="0 0 16 16">
                  <path d="M8 1.5l1.8 5.5H16l-4.6 3.3 1.8 5.5L8 11.5l-5.2 3.3 1.8-5.5L0 7h6.2z" />
                </svg>
                <svg data-star="2" class="pdp-star-icon-interactive" width="24" height="24" viewBox="0 0 16 16">
                  <path d="M8 1.5l1.8 5.5H16l-4.6 3.3 1.8 5.5L8 11.5l-5.2 3.3 1.8-5.5L0 7h6.2z" />
                </svg>
                <svg data-star="3" class="pdp-star-icon-interactive" width="24" height="24" viewBox="0 0 16 16">
                  <path d="M8 1.5l1.8 5.5H16l-4.6 3.3 1.8 5.5L8 11.5l-5.2 3.3 1.8-5.5L0 7h6.2z" />
                </svg>
                <svg data-star="4" class="pdp-star-icon-interactive" width="24" height="24" viewBox="0 0 16 16">
                  <path d="M8 1.5l1.8 5.5H16l-4.6 3.3 1.8 5.5L8 11.5l-5.2 3.3 1.8-5.5L0 7h6.2z" />
                </svg>
                <svg data-star="5" class="pdp-star-icon-interactive" width="24" height="24" viewBox="0 0 16 16">
                  <path d="M8 1.5l1.8 5.5H16l-4.6 3.3 1.8 5.5L8 11.5l-5.2 3.3 1.8-5.5L0 7h6.2z" />
                </svg>
                <svg width="0" height="0" style="position:absolute;">
                  <defs>
                    <linearGradient id="dynamicStarGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop id="dynamicStarStop1" offset="50%" stop-color="var(--color-warning-500)" />
                      <stop id="dynamicStarStop2" offset="50%" stop-color="var(--gray-300)" />
                    </linearGradient>
                  </defs>
                </svg>
                <span id="pdpHoverRatingVal"
                  style="margin-left: 12px; font-size: 1.1rem; font-weight: 600; color: var(--gray-700); font-variant-numeric: tabular-nums;">0.00</span>
              </div>
              <textarea class="pdp-reviews__textarea" id="pdpSubmitComment" placeholder="Write a review (optional)..."
                rows="3"></textarea>
              <button class="pdp-reviews__submit-btn" id="pdpSubmitReviewBtn">Submit Review</button>
            </div>

            <div class="pdp-reviews__list" id="pdpReviewsList">
              <div class="pdp-review-card pdp-review-card--skeleton">
                <div class="pdp-review-card__header">
                  <div class="pdp-skeleton pdp-skeleton--review-avatar"></div>
                  <div class="pdp-review-card__meta" style="flex:1;">
                    <div class="pdp-skeleton pdp-skeleton--line"
                      style="width: 110px; height: 14px; margin-bottom: 6px;"></div>
                    <div class="pdp-skeleton pdp-skeleton--line" style="width: 85px; height: 12px;"></div>
                  </div>
                </div>
                <div class="pdp-skeleton pdp-skeleton--line"
                  style="width: 100%; height: 14px; margin-top: 10px; margin-bottom: 6px;"></div>
                <div class="pdp-skeleton pdp-skeleton--line" style="width: 72%; height: 14px;"></div>
              </div>
              <div class="pdp-review-card pdp-review-card--skeleton">
                <div class="pdp-review-card__header">
                  <div class="pdp-skeleton pdp-skeleton--review-avatar"></div>
                  <div class="pdp-review-card__meta" style="flex:1;">
                    <div class="pdp-skeleton pdp-skeleton--line" style="width: 95px; height: 14px; margin-bottom: 6px;">
                    </div>
                    <div class="pdp-skeleton pdp-skeleton--line" style="width: 85px; height: 12px;"></div>
                  </div>
                </div>
                <div class="pdp-skeleton pdp-skeleton--line"
                  style="width: 96%; height: 14px; margin-top: 10px; margin-bottom: 6px;"></div>
                <div class="pdp-skeleton pdp-skeleton--line" style="width: 65%; height: 14px;"></div>
              </div>
            </div>
          </div>

          <!-- Related Products -->
          <section class="pdp-related reveal" aria-label="You may also like">
            <div class="pdp-related__header">
              <h2 class="pdp-related__title">You May Also Like</h2>
              <div class="pdp-related__controls">
                <button class="pdp-related__ctrl" id="pdpRelPrev" aria-label="Scroll left">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <polyline points="10 12 6 8 10 4" />
                  </svg>
                </button>
                <button class="pdp-related__ctrl" id="pdpRelNext" aria-label="Scroll right">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <polyline points="6 4 10 8 6 12" />
                  </svg>
                </button>
              </div>
            </div>
            <div class="pdp-related__viewport" id="pdpRelViewport">
              <div class="pdp-related__track" id="pdpRelTrack" role="list">
                <% for (let i=0; i < 4; i++) { %>
                  <article class="plp-card product-card--skeleton" role="listitem" style="width:200px; flex-shrink:0;">
                    <div class="plp-card__image-wrap">
                      <div class="pdp-skeleton" style="width:100%; height:160px; border-radius:0;"></div>
                    </div>
                    <div class="plp-card__body" style="display:flex; flex-direction:column; gap:8px; padding:12px;">
                      <div class="pdp-skeleton pdp-skeleton--line" style="width:40%; height:12px;"></div>
                      <div class="pdp-skeleton pdp-skeleton--line" style="width:88%; height:14px;"></div>
                      <div class="pdp-skeleton pdp-skeleton--line" style="width:64%; height:14px;"></div>
                      <div class="pdp-skeleton pdp-skeleton--line" style="width:52%; height:20px; margin-top:4px;">
                      </div>
                    </div>
                    <div class="plp-card__footer" style="padding: 0 12px 12px;">
                      <div class="pdp-skeleton" style="width:100%; height:36px; border-radius:var(--radius-lg, 10px);">
                      </div>
                    </div>
                  </article>
                  <% } %>
              </div>
            </div>
          </section>

        </div>
        <!-- end pdp-below-wrap -->


      </div>
      <!-- end pdp__container -->
    </main>

    <%# Footer %>
      <%- include('../../partials/home-footer') %>

        <!-- Data (must load before pdp.js) -->
        <script src="/assets/data/product-data.js"></script>
        <script src="/assets/data/category-plp-data.js"></script>

        <!-- JS -->
        <script src="/assets/js/category-header.js" defer></script>
        <script src="/assets/js/pdp.js" defer></script>

</body>

</html>
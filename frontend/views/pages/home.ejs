<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>

  <title><%= title %></title>
  <meta name="description" content="<%= description %>"/>
  <meta name="keywords" content="Kishor Mobiles, Kishor Enterprises, mobiles, TVs, ACs, refrigerators, home appliances, Pathapatnam electronics"/>
  <meta name="author" content="Kishor Mobiles"/>
  <meta name="robots" content="index, follow"/>

  <!-- Canonical URL -->
  <link rel="canonical" href="<%= locals.canonicalUrl || 'https://kishormobiles.in/home' %>"/>

  <!-- Google Search & Browser Favicons (Derived from official Kishor Mobiles logo) -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico"/>
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png"/>
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/images/favicon-48x48.png"/>
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/android-chrome-192x192.png"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png"/>

  <!-- Open Graph / Social Media Preview -->
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="Kishor Mobiles"/>
  <meta property="og:title" content="<%= title %>"/>
  <meta property="og:description" content="<%= description %>"/>
  <meta property="og:url" content="<%= locals.canonicalUrl || 'https://kishormobiles.in/home' %>"/>
  <meta property="og:image" content="https://kishormobiles.in/assets/images/kishor-mobiles-logo.png"/>
  <meta property="og:image:width" content="512"/>
  <meta property="og:image:height" content="512"/>
  <meta property="og:image:alt" content="Kishor Mobiles Official Logo"/>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary"/>
  <meta name="twitter:title" content="<%= title %>"/>
  <meta name="twitter:description" content="<%= description %>"/>
  <meta name="twitter:image" content="https://kishormobiles.in/assets/images/kishor-mobiles-logo.png"/>

  <!-- Schema.org JSON-LD Structured Data (WebSite + ElectronicsStore) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://kishormobiles.in/#website",
        "url": "https://kishormobiles.in/",
        "name": "Kishor Mobiles",
        "alternateName": "Kishor Enterprises",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://kishormobiles.in/products?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "ElectronicsStore",
        "@id": "https://kishormobiles.in/#store",
        "name": "Kishor Mobiles",
        "alternateName": "Kishor Enterprises",
        "url": "https://kishormobiles.in/",
        "logo": "https://kishormobiles.in/assets/images/kishor-mobiles-logo.png",
        "image": "https://kishormobiles.in/assets/images/kishor-mobiles-logo.png",
        "telephone": "+91-9963657799",
        "priceRange": "₹₹",
        "hasMap": "https://maps.app.goo.gl/MkDAzWNQdQArud8HA?g_st=ac",
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 18.747141,
          "longitude": 84.086327
        },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "All Andhra Road",
          "addressLocality": "Pathapatnam",
          "addressRegion": "Andhra Pradesh",
          "postalCode": "532213",
          "addressCountry": "IN"
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
            "opens": "09:00",
            "closes": "21:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Sunday"],
            "opens": "09:00",
            "closes": "19:00"
          }
        ]
      }
    ]
  }
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>

  <!-- ── Foundation ── -->
  <link rel="stylesheet" href="/assets/css/variables.css"/>
  <link rel="stylesheet" href="/assets/css/base.css"/>
  <link rel="stylesheet" href="/assets/css/utilities.css"/>

  <!-- ── Home page components ── -->
  <link rel="stylesheet" href="/assets/css/home-header.css"/>
  <link rel="stylesheet" href="/assets/css/home-category-strip.css"/>
  <link rel="stylesheet" href="/assets/css/home-hero.css"/>
  <link rel="stylesheet" href="/assets/css/home-trust.css"/>
  <link rel="stylesheet" href="/assets/css/home-product-section.css"/>
  <link rel="stylesheet" href="/assets/css/home-brands.css"/>
  <link rel="stylesheet" href="/assets/css/home-emi.css"/>
  <link rel="stylesheet" href="/assets/css/home-location.css"/>
  <link rel="stylesheet" href="/assets/css/home-footer.css"/>

  <!-- ── Shared reuse ── -->
  <link rel="stylesheet" href="/assets/css/footer.css"/>
  <link rel="stylesheet" href="/assets/css/login-required-modal.css"/>

  <!-- ── Responsive last ── -->
  <link rel="stylesheet" href="/assets/css/responsive.css"/>

  <style>
    /* Home page resets the landing navbar spacer — not needed here */
    body { padding-top: 0; }
  </style>
</head>

<body class="home-page">

  <%# ── Sticky header (logo + location + search + action icons) ── %>
  <%- include('../partials/home-header') %>

  <%# ── Sticky category strip (sits directly below header) ── %>
  <%- include('../partials/home-category-strip') %>

  <main id="main-content">

    <%# ── Hero banner carousel ── %>
    <%- include('../partials/home-hero') %>

    <%# ── Trust bar ── %>
    <%- include('../partials/home-trust') %>

    <%# ── Product sections — Netflix-style horizontal carousels ──
         Each include passes { sectionId, sectionTitle, eyebrow, viewAllHref }
         home-slider.js reads data-section to pull the right dataset.
    ── %>

    <%- include('../partials/home-product-section', {
      sectionId:    'trending',
      sectionTitle: 'Trending Deals',
      eyebrow:      "Today's Top Picks",
      viewAllHref:  '/products/trending',
    }) %>

    <%- include('../partials/home-product-section', {
      sectionId:    'mobiles',
      sectionTitle: 'Mobiles',
      eyebrow:      'Latest Smartphones',
      viewAllHref:  '/products/mobiles',
    }) %>

    <%- include('../partials/home-product-section', {
      sectionId:    'tvs',
      sectionTitle: 'TVs',
      eyebrow:      'Smart & OLED TVs',
      viewAllHref:  '/products/tvs',
    }) %>

    <%# ── EMI strip ── %>
    <%- include('../partials/home-emi') %>

    <%- include('../partials/home-product-section', {
      sectionId:    'acs',
      sectionTitle: 'Air Conditioners',
      eyebrow:      'Inverter & 5-Star',
      viewAllHref:  '/products/acs',
    }) %>

    <%- include('../partials/home-product-section', {
      sectionId:    'homeTheatres',
      sectionTitle: 'Home Theatres',
      eyebrow:      'Dolby Atmos & Soundbars',
      viewAllHref:  '/products/home-theatres',
    }) %>

    <%#
      Kitchen Appliances and Refrigerators sections are temporarily hidden
      because these categories are not yet available in the showroom.
      To re-enable: add back the home-product-section includes here and
      remove their slugs from src/config/categoryConfig.js.
    %>

    <%# ── Brands grid ── %>
    <%- include('../partials/home-brands') %>

    <%# ── Compact location ── %>
    <%- include('../partials/home-location') %>

  </main>

  <%# ── Footer ── %>
  <%- include('../partials/home-footer') %>

  <%# ── Auth modal (global) ── %>
  <%- include('../partials/login-required-modal') %>

  <!-- ── Data & Data Structures ── -->
  <script src="/assets/data/home-banners.js"></script>
  <script src="/assets/data/home-products.js"></script>
  <script src="/assets/js/banner-circular-list.js"></script>

  <!-- ── JS (deferred) ── -->
  <script src="/assets/js/home-hero.js"     defer></script>
  <script src="/assets/js/home-slider.js"   defer></script>
  <script src="/assets/js/home-header.js"   defer></script>
  <script src="/assets/js/auth-guard.js"    defer></script>
  <script src="/assets/js/whatsapp.js"      defer></script>

</body>
</html>

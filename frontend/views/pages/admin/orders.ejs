<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/admin/admin-head') %>
</head>
<body class="admin-body">

  <%- include('../../partials/admin/admin-header') %>

  <div class="admin-layout">

    <%- include('../../partials/admin/admin-sidebar') %>

    <main class="admin-main" id="main-content">
      <div class="admin-container">

        <!-- Breadcrumb navigation -->
        <nav class="admin-breadcrumb" aria-label="Breadcrumb">
          <ol class="admin-breadcrumb__list">
            <li class="admin-breadcrumb__item"><a href="/admin/dashboard" class="admin-breadcrumb__link">Dashboard</a></li>
            <li class="admin-breadcrumb__separator" aria-hidden="true">/</li>
            <li class="admin-breadcrumb__item admin-breadcrumb__item--active" aria-current="page">Orders</li>
          </ol>
        </nav>

        <!-- Page Header -->
        <div class="admin-page-header">
          <div class="admin-page-header__title-group">
            <span class="admin-page-header__eyebrow">Fulfillment & Operations</span>
            <h1 class="admin-page-header__title">Order Management</h1>
            <p class="admin-page-header__subtitle">Review incoming orders, process shipments, verify payment statuses, and update deliveries.</p>
          </div>
        </div>

        <!-- ── Status Filter Chips ── -->
        <div class="orders-filters" id="adminOrderFilterChips" role="group" aria-label="Filter orders by status">
          <button class="orders-filter-chip active" data-filter="all" type="button">
            <span class="orders-filter-chip__label">All Orders</span>
            <span class="orders-filter-chip__count" id="filterCountAll">0</span>
          </button>
          <button class="orders-filter-chip" data-filter="processing" type="button">
            <span class="orders-filter-chip__dot" style="background:#eab308;"></span>
            <span class="orders-filter-chip__label">Processing</span>
            <span class="orders-filter-chip__count" id="filterCountProcessing">0</span>
          </button>
          <button class="orders-filter-chip" data-filter="confirmed" type="button">
            <span class="orders-filter-chip__dot" style="background:#3b82f6;"></span>
            <span class="orders-filter-chip__label">Confirmed</span>
            <span class="orders-filter-chip__count" id="filterCountConfirmed">0</span>
          </button>
          <button class="orders-filter-chip" data-filter="out_for_delivery" type="button">
            <span class="orders-filter-chip__dot" style="background:#f97316;"></span>
            <span class="orders-filter-chip__label">Out for Delivery</span>
            <span class="orders-filter-chip__count" id="filterCountOutForDelivery">0</span>
          </button>
          <button class="orders-filter-chip" data-filter="delivered" type="button">
            <span class="orders-filter-chip__dot" style="background:#22c55e;"></span>
            <span class="orders-filter-chip__label">Delivered</span>
            <span class="orders-filter-chip__count" id="filterCountDelivered">0</span>
          </button>
          <button class="orders-filter-chip" data-filter="cancelled" type="button">
            <span class="orders-filter-chip__dot" style="background:#ef4444;"></span>
            <span class="orders-filter-chip__label">Cancelled</span>
            <span class="orders-filter-chip__count" id="filterCountCancelled">0</span>
          </button>
        </div>

        <!-- ── Toolbar Search & Sort ── -->
        <div class="admin-toolbar">
          <div class="admin-toolbar__left" style="display:flex; align-items:center; gap:var(--space-3); flex-wrap:wrap;">
            <div class="admin-search-input-wrap">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="9" r="6"/><path d="M13.5 13.5L17 17"/>
              </svg>
              <input type="search" id="orderSearchInput" class="admin-search-input" placeholder="Search by Order ID (#ORD / ES-...) or customer name..."/>
            </div>

            <select id="orderSortSelect" class="admin-select" title="Sort orders" style="min-width:210px;">
              <option value="date-desc" selected>Sort by Date: Newest First</option>
              <option value="date-asc">Sort by Date: Oldest First</option>
              <option value="status-asc">Sort by Status: In-Progress &rarr; Completed</option>
              <option value="status-desc">Sort by Status: Completed &rarr; In-Progress</option>
              <option value="payment-status">Sort by Payment Status (Paid First)</option>
              <option value="payment-high">Sort by Payment Amount: High to Low</option>
              <option value="payment-low">Sort by Payment Amount: Low to High</option>
            </select>
          </div>
          <div style="font-size: var(--text-xs); color: var(--color-text-muted); font-weight: var(--font-semibold);">
            Showing <span id="ordersCountDisplay">0</span> orders
          </div>
        </div>

        <!-- ── Orders Table Card ── -->
        <div class="admin-card">
          <div class="admin-card__body">
            <div class="admin-table-wrap">
              <table class="admin-table" id="ordersTable">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Total Amount</th>
                    <th class="admin-th-sortable" data-sort-field="payment" style="cursor:pointer; user-select:none;" title="Click to sort by Payment">
                      Payment <span id="sortIndicatorPayment" style="font-size:11px; opacity:0.6; margin-left:4px;">⇅</span>
                    </th>
                    <th class="admin-th-sortable" data-sort-field="status" style="cursor:pointer; user-select:none;" title="Click to sort by Order Status">
                      Order Status <span id="sortIndicatorStatus" style="font-size:11px; opacity:0.6; margin-left:4px;">⇅</span>
                    </th>
                    <th class="admin-th-sortable" data-sort-field="date" style="cursor:pointer; user-select:none;" title="Click to sort by Date">
                      Date <span id="sortIndicatorDate" style="font-size:11px; color:var(--color-primary-600); margin-left:4px;">↓</span>
                    </th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="ordersTableBody">
                  <!-- Populated by admin.js -->
                </tbody>
              </table>
            </div>

            <!-- Empty State -->
            <div class="admin-empty-state" id="ordersEmptyState" style="display: none;">
              <div class="admin-empty-state__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="9" y1="9" x2="15" y2="9"></line>
                  <line x1="9" y1="13" x2="15" y2="13"></line>
                </svg>
              </div>
              <h3 class="admin-empty-state__title">No Orders Found</h3>
              <p class="admin-empty-state__desc">No orders matched the selected filter or search term.</p>
              <button type="button" class="btn btn--outline btn--sm" id="resetOrderFiltersBtn">Clear Filter</button>
            </div>
          </div>
        </div>

      </div>
    </main>

  </div>

  <%- include('../../partials/admin/admin-footer') %>
  <%- include('../../partials/admin/admin-modals') %>

  <!-- Data & Scripts -->
  <script src="/assets/data/admin-mock-data.js"></script>
  <script src="/assets/js/admin.js" defer></script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/admin/admin-head') %>
</head>
<body class="admin-body">

  <%- include('../../partials/admin/admin-header') %>

  <div class="admin-layout">

    <%- include('../../partials/admin/admin-sidebar') %>

    <main class="admin-main" id="main-content">
      <div class="admin-container">

        <!-- Breadcrumb navigation -->
        <nav class="admin-breadcrumb" aria-label="Breadcrumb">
          <ol class="admin-breadcrumb__list">
            <li class="admin-breadcrumb__item"><a href="/admin/dashboard" class="admin-breadcrumb__link">Dashboard</a></li>
            <li class="admin-breadcrumb__separator" aria-hidden="true">/</li>
            <li class="admin-breadcrumb__item admin-breadcrumb__item--active" aria-current="page">Orders</li>
          </ol>
        </nav>

        <!-- Page Header -->
        <div class="admin-page-header">
          <div class="admin-page-header__title-group">
            <span class="admin-page-header__eyebrow">Fulfillment & Operations</span>
            <h1 class="admin-page-header__title">Order Management</h1>
            <p class="admin-page-header__subtitle">Review incoming orders, process shipments, verify payment statuses, and update deliveries.</p>
          </div>
        </div>

        <!-- ── Status Filter Chips (Matches User Panel orders.ejs styling) ── -->
        <div class="orders-filters" id="adminOrderFilterChips" role="group" aria-label="Filter orders by status" style="margin-bottom: var(--space-6);">
          <button class="orders-filter-chip active" data-filter="all">
            All Orders
          </button>
          <button class="orders-filter-chip" data-filter="processing">
            <span class="orders-filter-chip__dot" style="background:#eab308;"></span>
            Processing (1)
          </button>
          <button class="orders-filter-chip" data-filter="confirmed">
            <span class="orders-filter-chip__dot" style="background:#3b82f6;"></span>
            Confirmed (1)
          </button>
          <button class="orders-filter-chip" data-filter="out_for_delivery">
            <span class="orders-filter-chip__dot" style="background:#f97316;"></span>
            Out for Delivery (1)
          </button>
          <button class="orders-filter-chip" data-filter="delivered">
            <span class="orders-filter-chip__dot" style="background:#22c55e;"></span>
            Delivered (1)
          </button>
          <button class="orders-filter-chip" data-filter="cancelled">
            <span class="orders-filter-chip__dot" style="background:#ef4444;"></span>
            Cancelled (1)
          </button>
        </div>

        <!-- ── Toolbar Search ── -->
        <div class="admin-toolbar">
          <div class="admin-toolbar__left">
            <div class="admin-search-input-wrap">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="9" r="6"/><path d="M13.5 13.5L17 17"/>
              </svg>
              <input type="search" id="orderSearchInput" class="admin-search-input" placeholder="Search by Order ID (#ORD / ES-...) or customer name..."/>
            </div>
          </div>
          <div style="font-size: var(--text-xs); color: var(--color-text-muted); font-weight: var(--font-semibold);">
            Showing <span id="ordersCountDisplay">5</span> orders
          </div>
        </div>

        <!-- ── Orders Table Card ── -->
        <div class="admin-card">
          <div class="admin-card__body">
            <div class="admin-table-wrap">
              <table class="admin-table" id="ordersTable">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Total Amount</th>
                    <th>Payment</th>
                    <th>Order Status</th>
                    <th>Date</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="ordersTableBody">
                  <!-- Populated by admin.js -->
                </tbody>
              </table>
            </div>

            <!-- Empty State -->
            <div class="admin-empty-state" id="ordersEmptyState" style="display: none;">
              <div class="admin-empty-state__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="9" y1="9" x2="15" y2="9"></line>
                  <line x1="9" y1="13" x2="15" y2="13"></line>
                </svg>
              </div>
              <h3 class="admin-empty-state__title">No Orders Found</h3>
              <p class="admin-empty-state__desc">No orders matched the selected filter or search term.</p>
              <button type="button" class="btn btn--outline btn--sm" id="resetOrderFiltersBtn">Clear Filter</button>
            </div>
          </div>
        </div>

      </div>
    </main>

  </div>

  <%- include('../../partials/admin/admin-footer') %>
  <%- include('../../partials/admin/admin-modals') %>

  <!-- Scripts -->
  <script src="/assets/js/admin.js" defer></script>

</body>
</html>

<%#
  admin-sidebar.ejs — Admin Panel Navigation Sidebar.
  Supports desktop fixed sidebar and responsive mobile slide-out drawer with active pills and mini user card.
%>

<!-- Mobile drawer backdrop -->
<div class="admin-drawer-overlay" id="adminSidebarBackdrop" aria-hidden="true"></div>

<aside class="admin-sidebar" id="adminSidebar" aria-label="Admin Navigation">

  <div class="admin-sidebar__content">
    <!-- Main Section -->
    <div class="admin-nav-group">
      <div class="admin-nav-group__title">ADMIN</div>
      <nav class="admin-nav-items" aria-label="Admin Main">
        <!-- Dashboard -->
        <a href="/admin/dashboard" class="admin-nav-link <%= (typeof activeNav !== 'undefined' && activeNav === 'dashboard') ? 'active' : '' %>">
          <div class="admin-nav-link__left">
            <span class="admin-nav-link__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
              </svg>
            </span>
            <span>Dashboard</span>
          </div>
        </a>

        <!-- Admin Profile -->
        <a href="/admin/profile" class="admin-nav-link <%= (typeof activeNav !== 'undefined' && activeNav === 'profile') ? 'active' : '' %>">
          <div class="admin-nav-link__left">
            <span class="admin-nav-link__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </span>
            <span>Admin Profile</span>
          </div>
          <span class="admin-nav-badge" style="background:var(--color-primary-50); color:var(--color-primary-700);">My Info</span>
        </a>
      </nav>
    </div>

    <!-- Management Section -->
    <div class="admin-nav-group">
      <div class="admin-nav-group__title">STORE MANAGEMENT</div>
      <nav class="admin-nav-items" aria-label="Admin Management">

        <!-- Banners -->
        <a href="/admin/banners" class="admin-nav-link <%= (typeof activeNav !== 'undefined' && activeNav === 'banners') ? 'active' : '' %>">
          <div class="admin-nav-link__left">
            <span class="admin-nav-link__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </span>
            <span>Hero Banners</span>
          </div>
        </a>

        <!-- Products & Stock -->
        <a href="/admin/products" class="admin-nav-link <%= (typeof activeNav !== 'undefined' && activeNav === 'products') ? 'active' : '' %>">
          <div class="admin-nav-link__left">
            <span class="admin-nav-link__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </span>
            <span>Products & Stock</span>
          </div>
        </a>

        <!-- Registered Users -->
        <a href="/admin/users" class="admin-nav-link <%= (typeof activeNav !== 'undefined' && activeNav === 'users') ? 'active' : '' %>">
          <div class="admin-nav-link__left">
            <span class="admin-nav-link__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </span>
            <span>Customers & Users</span>
          </div>
        </a>

        <!-- Orders -->
        <a href="/admin/orders" class="admin-nav-link <%= (typeof activeNav !== 'undefined' && activeNav === 'orders') ? 'active' : '' %>">
          <div class="admin-nav-link__left">
            <span class="admin-nav-link__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="9" y1="9" x2="15" y2="9"></line>
                <line x1="9" y1="13" x2="15" y2="13"></line>
                <line x1="9" y1="17" x2="11" y2="17"></line>
              </svg>
            </span>
            <span>Orders & Shipping</span>
          </div>
        </a>

      </nav>
    </div>
  </div>

  <!-- Bottom Admin User Profile Card & Sign Out -->
  <div class="admin-sidebar__footer">
    <div class="admin-sidebar__user-card">
      <a href="/admin/profile" class="admin-sidebar__user-link" title="View Profile">
        <div class="admin-sidebar__user-avatar" id="sidebarUserAvatar"><%= (typeof adminUser !== 'undefined' && adminUser?.avatar) ? adminUser.avatar : 'AU' %></div>
        <div class="admin-sidebar__user-meta">
          <strong class="admin-sidebar__user-name" id="sidebarUserName"><%= (typeof adminUser !== 'undefined' && adminUser?.username) ? adminUser.username : 'Admin User' %></strong>
          <span class="admin-sidebar__user-role">Administrator</span>
        </div>
      </a>
      <button type="button" class="admin-sidebar__signout-icon-btn" id="adminSidebarLogoutBtn" title="Sign Out">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      </button>
    </div>
  </div>

</aside>

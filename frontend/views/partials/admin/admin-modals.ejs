<%# admin-modals.ejs — Centralized Admin Panel Modals & Drawers. Follows accessible modal/drawer patterns from the
  existing login-required-modal and orders drawer. %>

  <!-- ════════════════════════════════════════
     1. BANNER MODAL (Add / Edit)
════════════════════════════════════════ -->
  <div class="admin-modal-backdrop" id="bannerModal" role="dialog" aria-modal="true" aria-labelledby="bannerModalTitle"
    aria-hidden="true">
    <div class="admin-modal admin-modal--lg">
      <div class="admin-modal__header">
        <h3 class="admin-modal__title" id="bannerModalTitle">Add New Banner</h3>
        <button class="admin-modal__close" data-close-modal="bannerModal" aria-label="Close modal">&times;</button>
      </div>
      <form id="bannerForm" class="admin-modal__body">
        <input type="hidden" id="bannerFormId" name="id" value="" />

        <div class="admin-form-group">
          <label class="admin-label" for="bannerEyebrow">Eyebrow / Sub-tag</label>
          <input type="text" id="bannerEyebrow" name="eyebrow" class="admin-input"
            placeholder="e.g. Festival Season Offers" required />
        </div>

        <div class="admin-form-group">
          <label class="admin-label" for="bannerTitle">Banner Title</label>
          <input type="text" id="bannerTitle" name="title" class="admin-input" placeholder="e.g. Latest Smartphones"
            required />
        </div>

        <div class="admin-form-group">
          <label class="admin-label" for="bannerSubtitle">Description / Subtitle</label>
          <textarea id="bannerSubtitle" name="subtitle" class="admin-textarea" rows="2"
            placeholder="Short marketing description..."></textarea>
        </div>

        <!-- Banner Image (Upload Local or Online URL) -->
        <div class="admin-form-group">
          <div
            style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-2);">
            <label class="admin-label" style="margin-bottom: 0;">Banner Image / Graphic</label>
            <span class="admin-cloudinary-badge"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2">
                <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
              </svg> Cloudinary CDN</span>
          </div>
          <div class="admin-img-source-tabs" role="tablist">
            <button type="button" class="admin-img-tab active" data-img-tab="banner-file" role="tab"
              aria-selected="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              Upload Local File
            </button>
            <button type="button" class="admin-img-tab" data-img-tab="banner-url" role="tab" aria-selected="false">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
                </path>
              </svg>
              Online Image URL
            </button>
          </div>

          <!-- Local Upload Dropzone -->
          <div class="admin-img-panel active" id="bannerFilePanel">
            <div class="admin-dropzone" id="bannerDropzone">
              <input type="file" id="bannerFileInput" accept="image/*" class="admin-dropzone__input" />
              <div class="admin-dropzone__content">
                <div class="admin-dropzone__icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                </div>
                <p class="admin-dropzone__text"><strong>Click to browse</strong> or drag & drop banner image</p>
                <p class="admin-dropzone__hint">Supports JPG, PNG, WEBP, or SVG (Auto-uploaded to Cloudinary)</p>
                <div class="admin-upload-spinner" id="bannerUploadSpinner" style="display: none; margin-top: 8px;">
                  <span class="spinner-sm"></span>
                  <span style="font-size: 11px; font-weight: 600; color: #4338ca;">Uploading to Cloudinary...</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Online URL Input -->
          <div class="admin-img-panel" id="bannerUrlPanel" style="display: none;">
            <div class="admin-url-input-group">
              <input type="url" id="bannerImageUrlInput" class="admin-input"
                placeholder="https://example.com/banner-graphic.jpg" />
              <button type="button" class="btn btn--outline btn--sm" id="bannerApplyUrlBtn">Apply URL</button>
            </div>
            <p class="admin-form-hint">Paste direct image URL from Cloudinary, Unsplash, or CDN.</p>
          </div>

          <!-- Live Preview -->
          <div class="admin-banner-preview-box" id="bannerImgPreviewBox" style="display: none;">
            <img id="bannerImgPreviewElement" src="" alt="Banner Preview" />
            <button type="button" class="admin-img-clear-btn" id="bannerImgClearBtn" title="Remove image">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
              <span>Remove Image</span>
            </button>
          </div>
        </div>

        <div class="admin-form-row">
          <div class="admin-form-group">
            <label class="admin-label" for="bannerCtaText">CTA Button Text</label>
            <input type="text" id="bannerCtaText" name="ctaText" class="admin-input" placeholder="Shop Now" required />
          </div>
          <div class="admin-form-group">
            <label class="admin-label" for="bannerCategorySelect">Target Category</label>
            <select id="bannerCategorySelect" class="admin-form-select">
              <option value="all">ALL (Homepage & Storewide)</option>
              <option value="mobiles">Mobiles (Smartphones)</option>
              <option value="tvs">TVs (Televisions)</option>
              <option value="acs">Air Conditioners (ACs)</option>
              <option value="home-theatres">Home Theatres</option>
              <option value="custom">Custom Slug...</option>
            </select>
            <input type="text" id="bannerSlug" name="slug" class="admin-input" style="margin-top: 6px;"
              placeholder="Slug (e.g. all, mobiles, tvs, acs, home-theatres)" value="all" required />
          </div>
        </div>

        <div class="admin-form-row">
          <div class="admin-form-group">
            <label class="admin-label" for="bannerBadge">Promo Badge</label>
            <input type="text" id="bannerBadge" name="badge" class="admin-input" placeholder="Up to ₹5,000 Off" />
          </div>
          <div class="admin-form-group">
            <label class="admin-label" for="bannerStatus">Status</label>
            <select id="bannerStatus" name="status" class="admin-form-select">
              <option value="Active">Active (Visible on Home)</option>
              <option value="Inactive">Inactive (Hidden)</option>
            </select>
          </div>
        </div>
      </form>
      <div class="admin-modal__footer">
        <button type="button" class="btn btn--outline btn--sm" data-close-modal="bannerModal">Cancel</button>
        <button type="button" class="btn btn--primary btn--sm" id="saveBannerBtn">Save Banner</button>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════
     2. PRODUCT MODAL (Add / Edit)
════════════════════════════════════════ -->
  <div class="admin-modal-backdrop" id="productModal" role="dialog" aria-modal="true"
    aria-labelledby="productModalTitle" aria-hidden="true">
    <div class="admin-modal admin-modal--lg">
      <div class="admin-modal__header">
        <h3 class="admin-modal__title" id="productModalTitle">Add New Product</h3>
        <button class="admin-modal__close" data-close-modal="productModal" aria-label="Close modal">&times;</button>
      </div>
      <form id="productForm" class="admin-modal__body">
        <input type="hidden" id="productFormId" name="id" value="" />

        <div class="admin-form-group">
          <label class="admin-label" for="productName">Product Name</label>
          <input type="text" id="productName" name="name" class="admin-input"
            placeholder="e.g. Samsung Galaxy S25 Ultra 5G" required />
        </div>

        <div class="admin-form-row">
          <div class="admin-form-group">
            <label class="admin-label" for="productBrand">Brand</label>
            <input type="text" id="productBrand" name="brand" class="admin-input" placeholder="e.g. Samsung, Apple"
              required />
          </div>
          <div class="admin-form-group">
            <label class="admin-label" for="productCategory">Category</label>
            <select id="productCategory" name="category" class="admin-form-select">
              <option value="Mobiles">Mobiles</option>
              <option value="TVs">TVs</option>
              <option value="Air Conditioners">Air Conditioners</option>
              <option value="Refrigerators">Refrigerators</option>
              <option value="Home Theatres">Home Theatres</option>
              <option value="Kitchen Appliances">Kitchen Appliances</option>
            </select>
          </div>
        </div>

        <div class="admin-form-row">
          <div class="admin-form-group">
            <label class="admin-label" for="productPrice">Price (₹)</label>
            <input type="number" id="productPrice" name="price" class="admin-input" placeholder="134999" required />
          </div>
          <div class="admin-form-group">
            <label class="admin-label" for="productStock">Initial Stock Qty</label>
            <input type="number" id="productStock" name="stock" class="admin-input" placeholder="15" required />
          </div>
        </div>

        <div class="admin-form-row">
          <div class="admin-form-group">
            <label class="admin-label" for="productSlug">URL Slug <span
                style="font-weight: normal; font-size: 0.75rem; color: var(--admin-text-muted);">(auto-generated)</span></label>
            <input type="text" id="productSlug" name="slug" class="admin-input"
              placeholder="samsung-galaxy-s25-ultra" />
          </div>
          <div class="admin-form-group">
            <label class="admin-label" for="productAvailability">Availability</label>
            <select id="productAvailability" name="availability" class="admin-form-select">
              <option value="AVAILABLE">Available</option>
              <option value="NOT_AVAILABLE">Not Available / Out of Stock</option>
            </select>
          </div>
        </div>

        <!-- Product Images & Gallery Section -->
        <div class="admin-form-group">
          <div
            style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-2);">
            <label class="admin-label" style="margin-bottom: 0;">Product Images & Gallery (Multiple)</label>
            <div style="display: flex; align-items: center; gap: var(--space-2);">
              <span class="admin-cloudinary-badge"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2">
                  <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
                </svg> Cloudinary CDN</span>
              <span class="admin-badge-count" id="productImagesCount">0 images</span>
            </div>
          </div>

          <div class="admin-img-source-tabs" role="tablist">
            <button type="button" class="admin-img-tab active" data-img-tab="product-file" role="tab"
              aria-selected="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              Upload Local Files
            </button>
            <button type="button" class="admin-img-tab" data-img-tab="product-url" role="tab" aria-selected="false">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
                </path>
              </svg>
              Add Online Image URL
            </button>
          </div>

          <!-- Product File Dropzone -->
          <div class="admin-img-panel active" id="productFilePanel">
            <div class="admin-dropzone" id="productDropzone">
              <input type="file" id="productFileInput" accept="image/*" multiple class="admin-dropzone__input" />
              <div class="admin-dropzone__content">
                <div class="admin-dropzone__icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                </div>
                <p class="admin-dropzone__text"><strong>Click to browse files</strong> or drag & drop multiple images
                </p>
                <p class="admin-dropzone__hint">Select JPG, PNG, WEBP photos (Auto-uploaded to Cloudinary)</p>
                <div class="admin-upload-spinner" id="productUploadSpinner" style="display: none; margin-top: 8px;">
                  <span class="spinner-sm"></span>
                  <span style="font-size: 11px; font-weight: 600; color: #4338ca;"
                    id="productUploadSpinnerText">Uploading to Cloudinary...</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Product Online URL input -->
          <div class="admin-img-panel" id="productUrlPanel" style="display: none;">
            <div class="admin-url-input-group">
              <input type="url" id="productImageUrlInput" class="admin-input"
                placeholder="https://res.cloudinary.com/... or direct image URL" />
              <button type="button" class="btn btn--outline btn--sm" id="productAddUrlBtn">Add Image</button>
            </div>
            <p class="admin-form-hint">Paste direct image URL and click "Add Image" to include in the product gallery.
            </p>
          </div>

          <!-- Staged Product Images Gallery Grid -->
          <div class="admin-gallery-wrap" id="productGalleryWrap">
            <div class="admin-gallery-empty" id="productGalleryEmpty">
              <p>No images added yet. Upload local images or add image links above.</p>
            </div>
            <div class="admin-gallery-grid" id="productGalleryGrid">
              <!-- Populated dynamically by admin.js -->
            </div>
          </div>
        </div>

        <div class="admin-form-group">
          <label class="admin-label" for="productDescription">Description</label>
          <textarea id="productDescription" name="description" class="admin-textarea" rows="2"
            placeholder="Key specifications, display details, warranty..."></textarea>
        </div>

        <!-- ── Product Variants Section ── -->
        <div class="admin-form-group" id="productVariantsSection">
          <div
            style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-2);">
            <div style="display: flex; align-items: center; gap: var(--space-2);">
              <label class="admin-label" style="margin-bottom: 0;">Product Variants</label>
              <span class="admin-badge-count" id="productVariantsCount">0 variants</span>
            </div>
            <div style="display: flex; align-items: center; gap: var(--space-2);">
              <button type="button" class="btn btn--outline btn--xs" id="openCreateAttrModalBtn"
                title="Create a new Variant Attribute">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>New Attribute</span>
              </button>
              <button type="button" class="btn btn--outline btn--xs" id="addVariantCardBtn">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Add Variant</span>
              </button>
            </div>
          </div>
          <p class="admin-form-hint" style="margin-top: 0; margin-bottom: var(--space-3);">
            Configure product variants with combinations of attributes (RAM, Storage, Color, etc.) and optional price
            overrides.
          </p>

          <div id="productVariantsContainer" class="admin-variants-container">
            <!-- Populated dynamically by admin.js -->
          </div>
        </div>
      </form>
      <div class="admin-modal__footer">
        <button type="button" class="btn btn--outline btn--sm" data-close-modal="productModal">Cancel</button>
        <button type="button" class="btn btn--primary btn--sm" id="saveProductBtn">Save Product</button>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════
     3. STOCK ADJUSTMENT MODAL
════════════════════════════════════════ -->
  <div class="admin-modal-backdrop" id="stockModal" role="dialog" aria-modal="true" aria-labelledby="stockModalTitle"
    aria-hidden="true">
    <div class="admin-modal" style="max-width: 440px;">
      <div class="admin-modal__header">
        <h3 class="admin-modal__title" id="stockModalTitle">Update Inventory Stock</h3>
        <button class="admin-modal__close" data-close-modal="stockModal" aria-label="Close modal">&times;</button>
      </div>
      <div class="admin-modal__body">
        <input type="hidden" id="stockProductId" value="" />
        <p style="font-size: var(--text-sm); font-weight: var(--font-bold); margin-bottom: var(--space-4);"
          id="stockProductName">
          Product Name
        </p>
        <div class="admin-form-group">
          <label class="admin-label" for="stockQuantityInput">Current Stock Units</label>
          <div style="display: flex; align-items: center; gap: var(--space-3);">
            <button type="button" class="btn btn--outline btn--sm" id="stockDecBtn"
              style="padding: var(--space-2) var(--space-4);">-</button>
            <input type="number" id="stockQuantityInput" class="admin-input"
              style="text-align: center; font-size: var(--text-lg); font-weight: var(--font-bold);" value="10"
              min="0" />
            <button type="button" class="btn btn--outline btn--sm" id="stockIncBtn"
              style="padding: var(--space-2) var(--space-4);">+</button>
          </div>
        </div>
        <div class="admin-form-group" style="margin-bottom: 0;">
          <label class="admin-label" for="stockStatusSelect">Calculated Stock State</label>
          <select id="stockStatusSelect" class="admin-form-select">
            <option value="In Stock">In Stock</option>
            <option value="Low Stock">Low Stock (< 5 units)</option>
            <option value="Out of Stock">Out of Stock (0 units)</option>
          </select>
        </div>
      </div>
      <div class="admin-modal__footer">
        <button type="button" class="btn btn--outline btn--sm" data-close-modal="stockModal">Cancel</button>
        <button type="button" class="btn btn--primary btn--sm" id="saveStockBtn">Update Stock</button>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════
     4. USER DETAILS DRAWER
════════════════════════════════════════ -->
  <div class="admin-drawer-overlay" id="userDrawerOverlay" aria-hidden="true"></div>
  <aside class="admin-drawer" id="userDrawer" role="dialog" aria-modal="true" aria-labelledby="userDrawerTitle"
    aria-hidden="true">
    <div class="admin-drawer__header">
      <h3 class="admin-drawer__title" id="userDrawerTitle">Customer Details</h3>
      <button class="admin-drawer__close admin-modal__close" id="userDrawerClose"
        aria-label="Close drawer">&times;</button>
    </div>
    <div class="admin-drawer__body" id="userDrawerBody">
      <!-- Dynamically populated by admin.js -->
    </div>
  </aside>

  <!-- ════════════════════════════════════════
     5. ORDER DETAILS DRAWER
════════════════════════════════════════ -->
  <div class="admin-drawer-overlay" id="orderDrawerOverlay" aria-hidden="true"></div>
  <aside class="admin-drawer" id="orderDrawer" role="dialog" aria-modal="true" aria-labelledby="orderDrawerTitle"
    aria-hidden="true">
    <div class="admin-drawer__header">
      <h3 class="admin-drawer__title" id="orderDrawerTitle">Order Management Details</h3>
      <button class="admin-drawer__close admin-modal__close" id="orderDrawerClose"
        aria-label="Close drawer">&times;</button>
    </div>
    <div class="admin-drawer__body" id="orderDrawerBody">
      <!-- Dynamically populated by admin.js -->
    </div>
    <div class="admin-drawer__footer" id="orderDrawerFooter" style="display: none;">
      <!-- Fulfillment status action bar populated by admin.js -->
    </div>
  </aside>

  <!-- ════════════════════════════════════════
     6. ADMIN ORDER CANCELLATION MODAL
════════════════════════════════════════ -->
  <div class="admin-modal-backdrop" id="adminCancelReasonModal" role="dialog" aria-modal="true"
    aria-labelledby="adminCancelModalTitle" aria-hidden="true">
    <div class="admin-modal" style="max-width: 480px;">
      <div class="admin-modal__header">
        <h3 class="admin-modal__title" id="adminCancelModalTitle"
          style="color: #b91c1c; display:flex; align-items:center; gap:8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" y1="9" x2="9" y2="15"></line>
            <line x1="9" y1="9" x2="15" y2="15"></line>
          </svg>
          Cancel Order
        </h3>
        <button class="admin-modal__close" data-close-modal="adminCancelReasonModal"
          aria-label="Close modal">&times;</button>
      </div>
      <div class="admin-modal__body">
        <p style="font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: var(--space-4);">
          Please specify why this order is being cancelled. This reason will be recorded and displayed to the customer
          in their account order tracking.
        </p>

        <div class="admin-form-group">
          <label class="admin-label" for="adminCancelPreset">Select Cancellation Reason</label>
          <select id="adminCancelPreset" class="admin-form-select">
            <option value="Item(s) out of stock or inventory discrepancy">Item(s) out of stock or inventory discrepancy
            </option>
            <option value="Customer requested cancellation via phone/email">Customer requested cancellation via
              phone/email</option>
            <option value="Delivery location unreachable or invalid address">Delivery location unreachable or invalid
              address</option>
            <option value="Payment verification failed / Suspicious transaction">Payment verification failed /
              Suspicious transaction</option>
            <option value="Pricing error or product catalog inaccuracy">Pricing error or product catalog inaccuracy
            </option>
            <option value="OTHER">Other reason (Type custom message)</option>
          </select>
        </div>

        <div class="admin-form-group" id="adminCustomReasonWrap" style="display: none;">
          <label class="admin-label" for="adminCustomCancelReason">Custom Note to Customer</label>
          <textarea id="adminCustomCancelReason" class="admin-textarea" rows="3"
            placeholder="Provide specific explanation for the customer..."></textarea>
        </div>
      </div>
      <div class="admin-modal__footer" style="display:flex; justify-content:flex-end; gap:var(--space-3);">
        <button type="button" class="btn btn--outline btn--sm" data-close-modal="adminCancelReasonModal">Keep Order
          Active</button>
        <button type="button" class="btn btn--sm" id="confirmAdminCancelBtn"
          style="background:#ef4444; color:#fff; border:none; padding:var(--space-2) var(--space-4); border-radius:var(--radius-md); font-weight:var(--font-semibold); cursor:pointer;">Confirm
          Cancellation</button>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════
     7. CREATE VARIANT ATTRIBUTE MODAL
════════════════════════════════════════ -->
  <div class="admin-modal-backdrop" id="createAttributeModal" role="dialog" aria-modal="true"
    aria-labelledby="createAttributeModalTitle" aria-hidden="true">
    <div class="admin-modal" style="max-width: 480px;">
      <div class="admin-modal__header">
        <h3 class="admin-modal__title" id="createAttributeModalTitle">Create Variant Attribute</h3>
        <button class="admin-modal__close" data-close-modal="createAttributeModal"
          aria-label="Close modal">&times;</button>
      </div>
      <div class="admin-modal__body">
        <form id="createAttributeForm" onsubmit="return false;">
          <div class="admin-form-group">
            <label class="admin-label" for="newAttrDisplayName">Attribute Display Name <span
                style="color:var(--color-danger); font-size:12px;">*</span></label>
            <input type="text" id="newAttrDisplayName" class="admin-input"
              placeholder="e.g. Processor, Material, Display Size" required />
            <p class="admin-form-hint">Label shown to customers on the storefront product page.</p>
          </div>
          <div class="admin-form-group">
            <label class="admin-label" for="newAttrName">Attribute Code / Key <span
                style="color:var(--color-danger); font-size:12px;">*</span></label>
            <input type="text" id="newAttrName" class="admin-input" placeholder="e.g. processor, material, display-size"
              required />
            <p class="admin-form-hint">Unique system identifier (auto-generated from display name).</p>
          </div>
          <div class="admin-form-group" style="margin-bottom: 0;">
            <label class="admin-label" for="newAttrInitialValues">Initial Values / Options (optional)</label>
            <input type="text" id="newAttrInitialValues" class="admin-input"
              placeholder="e.g. Intel Core i7, AMD Ryzen 7, Apple M3" />
            <p class="admin-form-hint">Separate multiple values with commas. You can also add more later.</p>
          </div>
        </form>
      </div>
      <div class="admin-modal__footer">
        <button type="button" class="btn btn--outline btn--sm" data-close-modal="createAttributeModal">Cancel</button>
        <button type="button" class="btn btn--primary btn--sm" id="saveAttributeBtn">Create Attribute</button>
      </div>
    </div>
  </div>


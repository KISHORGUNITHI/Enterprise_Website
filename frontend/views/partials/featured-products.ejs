<%#
  featured-products.ejs — Netflix-style horizontal product carousel
  Future React component: <FeaturedProducts products={productsData} />
  Cards rendered by featured-slider.js
%>

<section class="featured section" id="featured" aria-labelledby="featured-heading">
  <div class="container">

    <div class="featured__header reveal">
      <div class="featured__header-text">
        <span class="section__eyebrow">Handpicked For You</span>
        <h2 class="section__title" id="featured-heading">Featured Products</h2>
        <p class="section__subtitle" style="text-align:left; margin-inline: 0;">
          Top-selling gadgets and appliances — all with official warranty and best-in-market pricing.
        </p>
      </div>
    </div>

  </div>

  <!-- Full-width scrollable track (outside container for edge-to-edge scroll) -->
  <div class="featured__viewport" aria-label="Product carousel">
    <div class="featured__track" id="featuredTrack" role="list">
      <%# Initial skeleton cards for immediate visual feedback before API resolves %>
      <% for (let i = 0; i < 5; i++) { %>
        <article class="product-card product-card--skeleton" role="listitem" aria-hidden="true">
          <div class="product-card__image-wrap">
            <div class="skeleton-shimmer skeleton-shimmer--image"></div>
          </div>
          <div class="product-card__body">
            <div class="skeleton-shimmer skeleton-shimmer--brand"></div>
            <div class="skeleton-shimmer skeleton-shimmer--title"></div>
            <div class="skeleton-shimmer skeleton-shimmer--title-short"></div>
            <div class="skeleton-shimmer skeleton-shimmer--rating"></div>
            <div class="skeleton-shimmer skeleton-shimmer--price"></div>
          </div>
          <div class="product-card__footer">
            <div class="skeleton-shimmer skeleton-shimmer--btn"></div>
          </div>
        </article>
      <% } %>
    </div>
  </div>

  <!-- Scroll progress indicator -->
  <div class="container">
    <div class="featured__scroll-bar" aria-hidden="true">
      <div class="featured__scroll-thumb" id="featuredScrollThumb"></div>
    </div>
  </div>

</section>

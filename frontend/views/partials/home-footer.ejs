        <!-- Col 2: Shop -->
        <nav class="home-footer__col" aria-label="Shop links">
          <h3 class="footer__col-heading">Shop</h3>
          <ul class="footer__nav-list" role="list">
            <li><a href="/products"              class="footer__nav-link">All Products</a></li>
            <li><a href="/products/mobiles"      class="footer__nav-link">Mobiles</a></li>
            <li><a href="/products/tvs"          class="footer__nav-link">TVs</a></li>
            <li><a href="/products/acs"          class="footer__nav-link">Air Conditioners</a></li>
            <li><a href="/products/refrigerators" class="footer__nav-link">Refrigerators</a></li>
            <li><a href="/products/kitchen"      class="footer__nav-link">Kitchen Appliances</a></li>
            <li><a href="/wishlist"              class="footer__nav-link">Wishlist</a></li>
          </ul>
        </nav>


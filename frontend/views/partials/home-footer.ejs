  <div class="home-footer__bottom">
    <div class="container--wide">
      <div class="footer__bottom-inner">
        <p class="footer__copyright">&copy; <span id="homeFooterYear"></span> Enterprise Store. All rights reserved.</p>
        <nav class="footer__legal-links" aria-label="Legal">
          <a href="#" class="footer__legal-link">Privacy Policy</a>
          <span class="footer__legal-sep" aria-hidden="true">·</span>
          <a href="#" class="footer__legal-link">Terms</a>
          <span class="footer__legal-sep" aria-hidden="true">·</span>
          <a href="#" class="footer__legal-link">Refund Policy</a>
        </nav>
      </div>
    </div>

<script>
  (function () {
    var serverAuth = <% - JSON.stringify({ isAuthenticated: Boolean(locals.isAuthenticated), isAdmin: Boolean(locals.isAdmin) }) %>;

    function syncAuthUI() {
      try {
        var isAuth = false;
        var isAdmin = false;

        var raw = localStorage.getItem('authUser');
        if (raw) {
          var u = JSON.parse(raw);
          if (u && (u.id || u.email)) {
            isAuth = true;
            isAdmin = (u.role === 'ADMIN' || u.role === 'admin');
          }
        }

        if (serverAuth && serverAuth.isAuthenticated) {
          isAuth = true;
          if (serverAuth.isAdmin) isAdmin = true;
        }

        if (isAuth) {
          if (document.body) {
            document.body.classList.add('is-authenticated');
            document.body.classList.add('has-mobile-bottom-bar');
            if (isAdmin) {
              document.body.classList.add('is-admin');
              document.body.classList.remove('is-user');
            } else {
              document.body.classList.add('is-user');
              document.body.classList.remove('is-admin');
            }
          }

          var loginBtn = document.getElementById('navbarLoginBtn');
          var profileBtn = document.getElementById('navProfileBtn');
          var logoutBtn = document.getElementById('navLogoutBtn');
          var mobileLogin = document.getElementById('navMobileLoginBtn');
          var mobileProfile = document.getElementById('navMobileProfileBtn');
          var adminBtn = document.getElementById('navAdminBtn');

          if (loginBtn) loginBtn.style.display = 'none';
          if (profileBtn) profileBtn.style.display = 'inline-flex';
          if (logoutBtn) logoutBtn.style.display = 'inline-flex';
          if (mobileLogin) mobileLogin.style.display = 'none';
          if (mobileProfile) mobileProfile.style.display = 'block';

          if (adminBtn) {
            adminBtn.style.display = isAdmin ? 'inline-flex' : 'none';
          }

          var bottomBar = document.getElementById('mobileBottomBar');
          var adminBottom = document.getElementById('mobileBottomBarAdmin');
          var userBottom = document.getElementById('mobileBottomBarUser');
          if (bottomBar) bottomBar.style.display = '';
          if (adminBottom) adminBottom.style.display = isAdmin ? '' : 'none';
          if (userBottom) userBottom.style.display = isAdmin ? 'none' : '';
          return;
        }

        // Unauthenticated state
        if (document.body) {
          document.body.classList.remove('is-authenticated', 'has-mobile-bottom-bar', 'is-admin', 'is-user');
        }
        var loginBtn = document.getElementById('navbarLoginBtn');
        var profileBtn = document.getElementById('navProfileBtn');
        var logoutBtn = document.getElementById('navLogoutBtn');
        var mobileLogin = document.getElementById('navMobileLoginBtn');
        var mobileProfile = document.getElementById('navMobileProfileBtn');
        var adminBtn = document.getElementById('navAdminBtn');
        var bottomBar = document.getElementById('mobileBottomBar');
        var adminBottom = document.getElementById('mobileBottomBarAdmin');
        var userBottom = document.getElementById('mobileBottomBarUser');

        if (loginBtn) loginBtn.style.display = '';
        if (profileBtn) profileBtn.style.display = 'none';
        if (logoutBtn) logoutBtn.style.display = 'none';
        if (mobileLogin) mobileLogin.style.display = '';
        if (mobileProfile) mobileProfile.style.display = 'none';
        if (adminBtn) adminBtn.style.display = 'none';
        if (bottomBar) bottomBar.style.display = 'none';
        if (adminBottom) adminBottom.style.display = 'none';
        if (userBottom) userBottom.style.display = 'none';
      } catch (e) { }
    }

    syncAuthUI();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncAuthUI);
    }
    window.addEventListener('storage', syncAuthUI);

    var logoutBtn = document.getElementById('navLogoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', function () {
        fetch('/logout', { method: 'POST', credentials: 'same-origin' })
          .finally(function () {
            localStorage.removeItem('authUser');
            localStorage.removeItem('authToken');
            localStorage.removeItem('pendingRoute');
            window.location.href = '/';
          });
      });
    }
  })();
</script>
<%#
  category-toolbar.ejs — Toolbar: category title, product count, sort dropdown, mobile filter button.
  Future React component: <CategoryToolbar label={pageLabel} slug={slug} />
%>

<div class="plp-toolbar" id="plpToolbar">
  <div class="plp__container">
    <div class="plp-toolbar__inner">

      <!-- Left: title + count -->
      <div class="plp-toolbar__left">
        <h2 class="plp-toolbar__category"><%= pageLabel %></h2>
        <p class="plp-toolbar__count" id="plpCount" aria-live="polite">Loading products…</p>
      </div>

      <!-- Right: sort -->
      <div class="plp-toolbar__right">

        <!-- Sort by -->
        <div class="plp-sort">
          <label class="plp-sort__label" for="plpSort">Sort by</label>
          <select class="plp-sort__select" id="plpSort" aria-label="Sort products">
            <option value="popularity">Popularity</option>
            <option value="newest">Newest First</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
            <option value="rating">Highest Rated</option>
            <option value="discount">Best Discount</option>
          </select>
        </div>

      </div>
    </div>
  </div>
</div>

<%#
  home-location.ejs — Compact store location strip for the Home page.
  Future React component: <HomeLocation />
%>

<section class="home-loc section--light" id="homeLocation" aria-labelledby="home-loc-heading">
  <div class="container--wide">

    <div class="home-loc__layout">

      <!-- Info side -->
      <div class="home-loc__info">
        <span class="section__eyebrow">Visit Us</span>
        <h2 class="home-loc__title" id="home-loc-heading">Our Store</h2>

        <div class="home-loc__details">
          <div class="home-loc__detail-item">
            <div class="home-loc__detail-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
            </div>
            <address class="home-loc__address">Main Road, Near City Center,<br>Hyderabad, Telangana — 500001</address>
          </div>
          <div class="home-loc__detail-item">
            <div class="home-loc__detail-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <p>Mon–Sat: 10AM – 9PM</p>
              <p>Sunday: 11AM – 7PM</p>
            </div>
          </div>
        </div>

        <div class="home-loc__actions">
          <a href="tel:9963657799" class="btn btn--primary">
            <svg class="icon icon--sm" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Call Store
          </a>
          <a href="https://maps.google.com/?q=Enterprise+Store+Hyderabad" target="_blank" rel="noopener noreferrer" class="btn btn--outline">
            Get Directions
          </a>
        </div>
      </div>

      <!-- Map side -->
      <div class="home-loc__map-wrap">
        <iframe
          class="home-loc__map"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d243647.31604788417!2d78.24323050982906!3d17.41228635785538!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bcb99daeaebd2c7%3A0xae93b78392bafbc2!2sHyderabad%2C%20Telangana!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
          width="100%" height="100%"
          style="border:0;" allowfullscreen="" loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Enterprise Store location"
        ></iframe>
      </div>

    </div>

  </div>
</section>

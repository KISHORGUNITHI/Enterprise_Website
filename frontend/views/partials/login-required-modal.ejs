<%#
  login-required-modal.ejs — Compact auth prompt modal
  Future React component: <LoginRequiredModal />

  Usage:
    Include once in landing.ejs (already done via footer area).
    Trigger from anywhere: showLoginRequiredModal('/products/mobiles')
%>

<div
  class="auth-modal-backdrop"
  id="authModalBackdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="authModalTitle"
  aria-describedby="authModalDesc"
  aria-hidden="true"
>
  <div class="auth-modal" id="authModal">

    <!-- Icon -->
    <div class="auth-modal__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="5" y="11" width="14" height="10" rx="3"
          stroke="currentColor" stroke-width="1.75" fill="none"/>
        <path d="M8 11V7a4 4 0 0 1 8 0v4"
          stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        <circle cx="12" cy="16" r="1.25" fill="currentColor"/>
      </svg>
    </div>

    <!-- Text -->
    <div class="auth-modal__body">
      <h2 class="auth-modal__title" id="authModalTitle">Login Required</h2>
      <p class="auth-modal__desc" id="authModalDesc">
        Sign in to continue shopping on Enterprise Store.
      </p>
    </div>

    <!-- Actions -->
    <div class="auth-modal__actions">
      <a href="/login" class="btn btn--primary auth-modal__btn--login" id="authModalLogin">
        Login
      </a>
      <a href="/signup" class="btn btn--outline auth-modal__btn--signup" id="authModalSignup">
        Create Account
      </a>
      <button
        class="auth-modal__btn--browse"
        id="authModalBrowse"
        aria-label="Close and continue browsing"
      >
        Continue Browsing
      </button>
    </div>

    <!-- Close button -->
    <button
      class="auth-modal__close"
      id="authModalClose"
      aria-label="Close login prompt"
    >
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13"/>
      </svg>
    </button>

  </div>
</div>

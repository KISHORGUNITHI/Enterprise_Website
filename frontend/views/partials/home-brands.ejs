<%#
  home-brands.ejs — Infinite dual-row brand marquee.
  Top row moves continuously left-to-right.
  Bottom row moves continuously right-to-left.
  Data is loaded dynamically from frontend/assets/data/brands.json.
%>

<%
  // Extract brands from server locals or fallback
  const bData = (typeof brandsData !== 'undefined' && brandsData) ? brandsData : null;
  const topBrands = (bData && Array.isArray(bData.topRow)) ? bData.topRow : [];
  const bottomBrands = (bData && Array.isArray(bData.bottomRow)) ? bData.bottomRow : [];

  function renderCard(brand, isDuplicate) {
    const displayName = brand.displayName || brand.name;
    const color = brand.color || '#1d1d1f';
    const fontSize = brand.fontSize || 16;
    const fontWeight = brand.fontWeight || '800';
    const fontFamily = brand.fontFamily || 'Arial,sans-serif';
    const viewBox = brand.viewBox || '0 0 80 36';
    const href = brand.href || '/products';
    const ariaLabel = `${brand.name} products`;
    const tabAttr = isDuplicate ? 'tabindex="-1"' : '';

    let logoMarkup = '';
    if (brand.logoSvg) {
      logoMarkup = brand.logoSvg;
    } else if (brand.logoUrl) {
      logoMarkup = `<img src="${brand.logoUrl}" alt="${brand.name}" class="brands-marquee__img" loading="lazy" />`;
    } else {
      logoMarkup = `<svg viewBox="${viewBox}" fill="none"><text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" font-size="${fontSize}" font-family="${fontFamily}" font-weight="${fontWeight}" fill="${color}">${displayName}</text></svg>`;
    }

    return `
      <a href="${href}" class="brands-marquee__card" aria-label="${ariaLabel}" ${tabAttr}>
        <div class="brands-marquee__logo" aria-hidden="true">
          ${logoMarkup}
        </div>
      </a>
    `;
  }
%>

<section class="brands section" id="brands" aria-labelledby="brands-heading">
  <div class="container--wide">
    <div class="section__header reveal">
      <span class="section__eyebrow">Our Partners</span>
      <h2 class="section__title" id="brands-heading">Brands We Sell</h2>
      <p class="section__subtitle">Official authorized dealer for 100+ top electronics brands.</p>
    </div>
  </div>

  <div class="brands-marquee" aria-label="Brands we sell showcase">

    <!-- Top Row: Moves Left to Right -->
    <div class="brands-marquee__row brands-marquee__row--top" aria-label="Featured Brands Row 1">
      <div class="brands-marquee__track brands-marquee__track--to-right">
        <!-- Group 1: Accessible items -->
        <div class="brands-marquee__group">
          <% topBrands.forEach(function(b) { %>
            <%- renderCard(b, false) %>
          <% }); %>
          <% topBrands.forEach(function(b) { %>
            <%- renderCard(b, true) %>
          <% }); %>
        </div>
        <!-- Group 2: Duplicate group for seamless infinite loop -->
        <div class="brands-marquee__group" aria-hidden="true">
          <% topBrands.forEach(function(b) { %>
            <%- renderCard(b, true) %>
          <% }); %>
          <% topBrands.forEach(function(b) { %>
            <%- renderCard(b, true) %>
          <% }); %>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Moves Right to Left -->
    <div class="brands-marquee__row brands-marquee__row--bottom" aria-label="Featured Brands Row 2">
      <div class="brands-marquee__track brands-marquee__track--to-left">
        <!-- Group 1: Accessible items -->
        <div class="brands-marquee__group">
          <% bottomBrands.forEach(function(b) { %>
            <%- renderCard(b, false) %>
          <% }); %>
          <% bottomBrands.forEach(function(b) { %>
            <%- renderCard(b, true) %>
          <% }); %>
        </div>
        <!-- Group 2: Duplicate group for seamless infinite loop -->
        <div class="brands-marquee__group" aria-hidden="true">
          <% bottomBrands.forEach(function(b) { %>
            <%- renderCard(b, true) %>
          <% }); %>
          <% bottomBrands.forEach(function(b) { %>
            <%- renderCard(b, true) %>
          <% }); %>
        </div>
      </div>
    </div>

  </div>
</section>

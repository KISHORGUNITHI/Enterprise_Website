<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/header') %>
</head>
<body>
    <%- include('../partials/navbar', { isAuthPage: true }) %>

    <main class="auth-wrapper">
        <div class="auth-container" id="authContainer">
            
            <!-- SIGN UP FORM -->
            <%- include('../auth/signup-form') %>

            <!-- LOGIN FORM -->
            <%- include('../auth/login-form') %>

            <!-- SLIDING PANEL (OVERLAY) -->
            <%- include('../partials/auth/auth-panel') %>

        </div>
    </main>

    <%- include('../partials/footer',{isAuthPage:true}) %>

    <!-- Scripts / Footer elements -->
     <script>
        const successMessage="<%= typeof message!=='undefined' ? message:'' %>"
        const errorMessage = "<%= typeof error !== 'undefined' ? error : '' %>";
    </script>
    <%- include('../partials/auth/auth-footer') %>
</body>
</html>
